# Copy to .env and fill secrets (same shape as MIDAS backend/.env)

# --- Primary: direct Azure OpenAI chat (Option B) ---
LLM_CHAT_API_KEY=
LLM_CHAT_API_BASE=
LLM_CHAT_API_VERSION=2025-01-01-preview
LLM_CHAT_MODEL=gpt-4.1-mini

# Legacy Azure aliases (optional if LLM_CHAT_* set above)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Fallback: corporate LiteLLM gateway (Option A) ---
LLM_GATEWAY_FALLBACK=true
LLM_GATEWAY_URL=
LLM_GATEWAY_VIRTUAL_KEY=

# Legacy gateway-only mode (skips direct Azure; not recommended)
LLM_USE_GATEWAY=false

# Embedding (not used by GenAI insights)
LLM_EMBEDDING_API_KEY=

# GenAI narrative insights (diagnostics + evaluation agents)
LLM_INSIGHTS_ENABLED=true
# Optional override for prompt markdown directory
# GENAI_PROMPTS_DIR=
