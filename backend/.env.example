# Copy to .env and fill secrets (same shape as MIDAS backend/.env)

# LiteLLM configuration for Azure OpenAI
LLM_CHAT_API_KEY=
# Embedding LiteLLM configuration for Azure OpenAI
LLM_EMBEDDING_API_KEY=

LLM_USE_GATEWAY=false
LLM_GATEWAY_URL=
LLM_GATEWAY_VIRTUAL_KEY=

# GenAI narrative insights (diagnostics + evaluation agents)
LLM_INSIGHTS_ENABLED=true
# Optional override for prompt markdown directory
# GENAI_PROMPTS_DIR=

